# ─────────────────────────────────────────────────────────────
#  GULABARI — environment
#  Copy to `.env` (or set these in your host's dashboard).
#  Every value is optional: with no DATABASE_URL the storefront
#  runs entirely from the seed catalogue in src/db/seed-data.ts.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection used by Drizzle ORM.
# Leave unset to run the site in read-only "mock" demo mode.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/gulabari"

# Absolute origin used for canonical URLs, Open Graph images,
# sitemap.xml and JSON-LD. Set this to the real domain in production.
NEXT_PUBLIC_SITE_URL="https://gulabari-sanganeri-fashion.vercel.app"
